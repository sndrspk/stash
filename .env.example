# Copy to .env and fill in. Never commit .env — it is git-ignored for a reason.
# In production these are set as environment variables on the host, not from a file.

# --- Instapaper Full API ---
# Issued by Instapaper on request. xAuth must be enabled on this key separately;
# if the token exchange 401s with a valid signature, that permission is missing.
INSTAPAPER_CONSUMER_KEY=
INSTAPAPER_CONSUMER_SECRET=

# --- Instapaper account token ---
# Produced by `npm run connect`, which prompts for your Instapaper email and
# password locally, exchanges them once, prints these two values, and stores
# nothing. The password never reaches the deployed app.
INSTAPAPER_OAUTH_TOKEN=
INSTAPAPER_OAUTH_TOKEN_SECRET=

# --- Access gate ---
# The passphrase that unlocks your deployment. This is the only thing between
# the public internet and an account someone can delete bookmarks from — make
# it long and random.
STASH_PASSPHRASE=

# --- Encryption ---
# 32 random bytes, base64. Encrypts the per-host site cookies at rest, so the
# KV provider never holds plaintext sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this invalidates stored site sessions (you re-paste them); it does
# NOT affect the Instapaper token above.
STASH_ENCRYPTION_KEY=
