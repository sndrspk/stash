# Copy to .env and fill in. Never commit .env — it is git-ignored for a reason.
# In production these are set as environment variables on the host, not from a file.

# --- Instapaper Full API ---
# Issued by Instapaper on request. xAuth must be enabled on this key separately;
# if the token exchange 401s with a valid signature, that permission is missing.
INSTAPAPER_CONSUMER_KEY=
INSTAPAPER_CONSUMER_SECRET=

# --- Instapaper account token ---
# Produced by `npm run connect`, which prompts for your Instapaper email and
# password locally, exchanges them once, prints these two values, and stores
# nothing. The password never reaches the deployed app.
INSTAPAPER_OAUTH_TOKEN=
INSTAPAPER_OAUTH_TOKEN_SECRET=

# --- Access gate ---
# The passphrase that unlocks your deployment. This is the only thing between
# the public internet and an account someone can delete bookmarks from — make
# it long and random.
STASH_PASSPHRASE=

# --- Encryption ---
# 32 random bytes, base64. Encrypts the per-host site cookies at rest, so the
# KV provider never holds plaintext sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this invalidates stored site sessions (you re-paste them); it does
# NOT affect the Instapaper token above.
STASH_ENCRYPTION_KEY=

# --- Key-value store (optional) ---
# Where the encrypted publisher sessions live. Two transports, and a deployment
# needs whichever its provider actually offers.
#
# Redis over HTTP, preferred where it exists: stateless, so no connection to go
# stale between invocations and no handshake on a cold start. Attach a KV store
# to the project and the host injects KV_REST_API_URL / _TOKEN; Upstash directly
# gives you UPSTASH_REDIS_REST_URL / _TOKEN. Set STASH_KV_* only to override both
# when a project has more than one store attached.
STASH_KV_URL=
STASH_KV_TOKEN=

# Redis over TCP, for the managed Redis that has no HTTP endpoint at all —
# Redis Cloud, ElastiCache, a plain server. Providers inject REDIS_URL (or
# KV_URL, or UPSTASH_REDIS_URL) on their own; set STASH_REDIS_URL only to
# override them. Use rediss:// rather than redis:// wherever the provider
# offers it — the connection carries the reader's publisher credentials.
# HTTP wins when both are configured.
STASH_REDIS_URL=

# Leave every one of them unset and Settings says so plainly, naming the
# variables it looked for — extraction still runs, anonymously, which already
# handles a good share of soft paywalls.
