# Secrets — never commit these
.env
.env.*
!.env.example
*.pem

# Publisher session cookies. These are credentials for your paid subscriptions.
sessions.json
sessions.*.json
sessions.txt
!sessions.example.txt

# Untouched captures from a real account: publishers' article prose and a record
# of what someone reads. `npm run capture` writes anonymised fixtures alongside
# these; only those are committed.
fixtures/.raw/

# Dependencies
node_modules/

# Build output
dist/
dev-dist/
.vercel/

# Editor / OS
.DS_Store
*.log
.idea/
.vscode/
